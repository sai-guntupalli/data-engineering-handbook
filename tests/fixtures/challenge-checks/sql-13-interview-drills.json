    "metadata": {},
    "outputs": [],
    "source": [
     "q = \"\"\"\n",
     "    SELECT id,\n",
     "           SUM(amount) OVER (ORDER BY d)     AS by_date_only,\n",
     "           SUM(amount) OVER (ORDER BY d, id) AS by_date_and_id\n",
     "    FROM VALUES (1, DATE '2023-01-01', 10), (2, DATE '2023-01-02', 20), (3, DATE '2023-01-02', 30) AS t(id, d, amount)\n",
     "    ORDER BY id\n",
     "    \"\"\"\n",
     "spark.sql(q).show()\n",
     "assert rows(q) == [(1, 10, 10), (2, 60, 30), (3, 60, 60)]"
    ]
   }
  },
  {
   "before": "becfacf4",
   "cell": {
    "cell_type": "code",
    "execution_count": null,
    "id": "127058cd",
    "metadata": {},
    "outputs": [],
    "source": [
     "q = \"\"\"\n",
     "    WITH u AS (\n",
     "        SELECT * FROM VALUES (1, 9, 100, DATE '2023-06-01'), (2, 9, 110, DATE '2023-06-01')\n",
     "        AS u(update_id, emp_id, salary, updated_at)\n",
     "    )\n",
     "    SELECT u.update_id FROM u\n",
     "    JOIN (SELECT emp_id, MAX(updated_at) AS max_ts FROM u GROUP BY emp_id) m\n",
     "      ON m.emp_id = u.emp_id AND m.max_ts = u.updated_at\n",
     "    ORDER BY u.update_id\n",
     "    \"\"\"\n",
     "assert rows(q) == [(1,), (2,)]"
    ]
   }
  },
