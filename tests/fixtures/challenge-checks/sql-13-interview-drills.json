     "q = \"\"\"\n",
     "    SELECT customer_id, order_date, running_total FROM (\n",
     "        SELECT customer_id, order_date, status,\n",
     "               SUM(amount) OVER (PARTITION BY customer_id ORDER BY order_date, order_id) AS running_total\n",
     "        FROM orders\n",
     "    )\n",
     "    WHERE status = 'completed' AND customer_id = 2\n",
     "    ORDER BY order_date\n",
     "    \"\"\"\n",
     "assert rows(q) == [(2, date(2023, 1, 20), 300), (2, date(2023, 3, 20), 950)]"
    ]
